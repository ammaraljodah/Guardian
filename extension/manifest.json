{
  "manifest_version": 3,
  "name": "Guardian - Parental Site Blocker",
  "version": "2.0.2",
  "description": "PIN-protected parental control that blocks sites and whole categories. Syncs with a local Guardian backend shared across Chrome profiles.",
  "permissions": ["tabs", "storage", "unlimitedStorage", "webNavigation", "idle", "alarms", "scripting"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["keys.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
